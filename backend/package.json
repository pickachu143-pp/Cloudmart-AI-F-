{
  "name": "cloudmart-ai-backend",
  "version": "1.0.0",
  "description": "CloudMart AI - Enterprise E-Commerce Platform Backend (Node.js + Express + TypeScript)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "seed": "ts-node src/utils/seed.ts"
  },
  "keywords": ["ecommerce", "ibm-cloud", "watson", "cloudant", "express", "typescript"],
  "author": "CloudMart AI Engineering",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "mongoose": "^8.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.4.0",
    "morgan": "^1.10.0",
    "winston": "^3.13.1",
    "zod": "^3.23.8",
    "compression": "^1.7.4",
    "axios": "^1.7.4",
    "@ibm-cloud/cloudant": "^0.9.1",
    "ibm-cloud-sdk-core": "^5.0.2",
    "cookie-parser": "^1.4.6",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "ts-node": "^10.9.2",
    "nodemon": "^3.1.4",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "@types/cors": "^2.8.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
