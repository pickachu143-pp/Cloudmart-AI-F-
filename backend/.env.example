# ================================
# CloudMart AI - Backend Env Vars
# ================================

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database provider: "mongodb" or "cloudant"
DB_PROVIDER=mongodb

# MongoDB
MONGO_URI=mongodb://localhost:27017/cloudmart-ai

# IBM Cloudant (used when DB_PROVIDER=cloudant, and always for AI event logging)
CLOUDANT_URL=https://apikey-xxxx.cloudantnosqldb.appdomain.cloud
CLOUDANT_APIKEY=your-cloudant-apikey
CLOUDANT_DB_NAME=cloudmart_events

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# IBM Watson (Natural Language Understanding - powers recommendations)
WATSON_NLU_APIKEY=your-watson-nlu-apikey
WATSON_NLU_URL=https://api.us-south.natural-language-understanding.watson.cloud.ibm.com/instances/your-instance
WATSON_ENABLED=true

# Logging
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
